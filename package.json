{
  "name": "sagittarius",
  "private": true,
  "packageManager": "pnpm@8.15.9",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @sagittarius/db migrate:dev",
    "db:migrate:deploy": "pnpm --filter @sagittarius/db migrate:deploy",
    "db:seed": "pnpm --filter @sagittarius/db seed",
    "db:generate": "pnpm --filter @sagittarius/db generate"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "embedded-postgres": "18.3.0-beta.17",
    "prettier": "^3.2.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  }
}
